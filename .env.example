# FeelPay Environment Config (Example)
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST/neondb?sslmode=require

JWT_SECRET=your_secure_secret_256_bits_minimum_change_in_production
WEBHOOK_SIGNING_SECRET=whsec_placeholder_example_only

# Payment mode: test | live
PAYMENT_MODE=test

CORS_ALLOWED_ORIGINS='http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173'
ADMIN_CORS_ALLOWED_ORIGINS='http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174'
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8081

# Secret reveal policy (keep false in production)
ALLOW_SECRET_REVEAL=false

# DigiLocker eKYC integration
DIGILOCKER_ENABLED=false
DIGILOCKER_CLIENT_ID=replace_with_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=replace_with_digilocker_client_secret
DIGILOCKER_REDIRECT_URI=https://your-dashboard-domain/onboarding
DIGILOCKER_AUTH_BASE_URL=https://api.digitallocker.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://api.digitallocker.gov.in/public/oauth2/1/token
DIGILOCKER_DOCS_URL=https://api.digitallocker.gov.in/public/oauth2/2/files
DIGILOCKER_TIMEOUT_SECS=12
