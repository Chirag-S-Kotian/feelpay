# FeelPay Environment Config (Example)
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST/neondb?sslmode=require
REDIS_URL=redis://localhost:6379
# Use a separate Neon dev/test branch for migrations and test execution.
TEST_DATABASE_URL=postgresql://YOUR_TEST_DB_USER:YOUR_TEST_DB_PASSWORD@YOUR_TEST_DB_HOST/neondb?sslmode=require
# Optional alias when you want the variable name to state the provider explicitly.
NEON_TEST_DATABASE_URL=postgresql://YOUR_TEST_DB_USER:YOUR_TEST_DB_PASSWORD@YOUR_TEST_DB_HOST/neondb?sslmode=require

JWT_SECRET=your_secure_secret_256_bits_minimum_change_in_production
MASTER_API_KEY=fp_master_key_change_in_production
VAULT_ENCRYPTION_KEY=replace_with_64_hex_chars
VAULT_KEY_ID=key_v1
WEBHOOK_SIGNING_SECRET=whsec_placeholder_example_only

# Runtime environment: development | staging | production
APP_ENV=development
# Payment mode: test | live
PAYMENT_MODE=test
HOST=127.0.0.1
PORT=8080
JWT_EXPIRY_HOURS=24
WEBHOOK_MAX_RETRIES=8
WEBHOOK_INITIAL_DELAY_SECS=1
SETTLEMENT_CYCLE_DAYS=2
PLATFORM_FEE_PERCENTAGE=2.0
RATE_LIMIT_PER_MINUTE=60
TENANT_ISOLATION_MODE=shared_table
DATABASE_PROVIDER=auto
DATABASE_URL_DOCKER=
DATABASE_URL_NEON=
UPI_PSP_ID=FEELPAY
UPI_MERCHANT_VPA=merchant@feelpay

CORS_ALLOWED_ORIGINS='http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173'
ADMIN_CORS_ALLOWED_ORIGINS='http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174'
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8081

# Secret reveal policy (keep false in production)
ALLOW_SECRET_REVEAL=false

# DigiLocker eKYC integration
DIGILOCKER_ENABLED=false
DIGILOCKER_CLIENT_ID=replace_with_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=replace_with_digilocker_client_secret
DIGILOCKER_REDIRECT_URI=https://your-dashboard-domain/onboarding
DIGILOCKER_AUTH_BASE_URL=https://api.digitallocker.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://api.digitallocker.gov.in/public/oauth2/1/token
DIGILOCKER_DOCS_URL=https://api.digitallocker.gov.in/public/oauth2/2/files
DIGILOCKER_TIMEOUT_SECS=12

# Optional runtime integrations and artifact storage.
EMAIL_PROVIDER=simulator
EMAIL_FROM_ADDRESS=noreply@feelpay.in
SENDGRID_API_KEY=
POSTMARK_API_KEY=
SMS_PROVIDER=simulator
MSG91_API_KEY=
MSG91_SENDER_ID=FEELPY
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PAYMENT_LINK_BASE_URL=https://your-dashboard-domain/pay
CHECKOUT_LINK_SIGNING_SECRET=replace_with_non_default_secret
STORAGE_SIGNER_URL=
EXPORT_ARTIFACTS_DIR=
REPORT_EXPORT_DIR=
REPORT_STORAGE_DIR=
