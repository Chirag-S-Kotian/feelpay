# Copy to a secret-managed staging env source. Do not commit real values.
DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_HOST/neondb?sslmode=require
TEST_DATABASE_URL=postgresql://VALIDATION_USER:VALIDATION_PASSWORD@VALIDATION_HOST/neondb?sslmode=require
REDIS_URL=redis://STAGING_REDIS_HOST:6379
JWT_SECRET=replace_with_staging_secret
MASTER_API_KEY=replace_with_staging_master_key
VAULT_ENCRYPTION_KEY=replace_with_64_hex_chars
WEBHOOK_SIGNING_SECRET=replace_with_staging_webhook_secret
PAYMENT_LINK_BASE_URL=https://dashboard-staging.example.com/pay
CHECKOUT_LINK_SIGNING_SECRET=replace_with_staging_checkout_secret

CORS_ALLOWED_ORIGINS=https://dashboard-staging.example.com
ADMIN_CORS_ALLOWED_ORIGINS=https://admin-staging.example.com
VITE_API_BASE_URL=https://api-staging.example.com
VITE_SANDBOX_API_BASE_URL=https://api-staging.example.com
VITE_LIVE_API_BASE_URL=https://api-staging.example.com
VITE_ADMIN_API_BASE_URL=https://admin-api-staging.example.com
VITE_DASHBOARD_BASE_URL=https://dashboard-staging.example.com
STAGING_HTTP_PORT=8080
