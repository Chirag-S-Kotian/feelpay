{
  "name": "feelpay-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/merchant-auth.spec.ts e2e/login-flow.spec.ts --project=chromium-desktop",
    "test:e2e:full-merchant": "playwright test e2e/merchant-*.spec.ts --project=chromium-desktop",
    "test:e2e:a11y": "playwright test e2e/merchant-a11y.spec.ts e2e/login-flow.spec.ts --project=chromium-desktop"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.15.0",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.5",
    "jsdom": "^25.0.1"
  }
}
